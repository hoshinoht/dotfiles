{
  "vim_mode": false,
  "status_bar": {
    "cursor_position_button": true
  },
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "disable_ai": false,
  "proxy": "",
  "cursor_shape": "bar",
  "minimum_contrast_for_highlights": 60.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent": {
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "flexible": false,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "git": {
    "disable_git": false,
    "inline_blame": {
      "enabled": false
    }
  },
  "tab_bar": {
    "show": false
  },
  "search": {
    "include_ignored": false
  },
  "sticky_scroll": {
    "enabled": false
  },
  "vertical_scroll_margin": 0.0,
  "minimap": {
    "show": "never"
  },
  "cursor_blink": false,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "auto_indent_on_paste": true,
  "show_whitespaces": "none",
  "tab_size": 2,
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dusk Darker"
  }
}
