{
  "git_panel": {
    "button": true,
    "file_icons": false
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "project_panel": {
    "git_status": true,
    "button": true
  },
  "tabs": {
    "git_status": false
  },
  "vim_mode": false,
  "status_bar": {
    "show_active_file": true,
    "pending_keystrokes_indicator": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
    "active_language_button": true,
    "cursor_position_button": true
  },
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "disable_ai": false,
  "proxy": "",
  "cursor_shape": "bar",
  "minimum_contrast_for_highlights": 60.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent": {
    "sandbox_permissions": {
      "write_paths": [
        {
          "requested": "/Users/cantabile/.local/share/opencode/log",
          "resolved": "/Users/cantabile/.local/share/opencode/log"
        }
      ]
    },
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^opencode/packages/model-presets/"
            }
          ]
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "flexible": false,
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "button": true,
    "font_family": "Maple Mono NF V8",
    "font_features": {
      "calt": false,
      "liga": false,
      "dlig": false
    }
  },
  "git": {
    "disable_git": false,
    "inline_blame": {
      "enabled": false
    }
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": false
  },
  "search": {
    "include_ignored": false
  },
  "sticky_scroll": {
    "enabled": false
  },
  "vertical_scroll_margin": 0.0,
  "minimap": {
    "show": "never"
  },
  "cursor_blink": false,
  "buffer_font_family": "Maple Mono NF V8",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false
  },
  "auto_indent_on_paste": true,
  "show_whitespaces": "none",
  "tab_size": 2,
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dusk Darker"
  }
}
