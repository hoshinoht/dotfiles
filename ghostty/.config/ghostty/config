# ---------------------------------------------------------
# Appearance & Theme
# ---------------------------------------------------------
theme = dusk-darker
background-opacity = 0.85
background-blur-radius = 10
# minimum-contrast = 1

# Minimal Window Styling (keep traffic light buttons)
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-padding-x = 15
window-padding-y = 15
window-save-state = always

# ---------------------------------------------------------
# Typography
# ---------------------------------------------------------
font-family = "Monaspace Neon NF"
font-family-bold = "Monaspace Neon NF"
font-family-italic = "Monaspace Neon NF"
font-family-bold-italic = "Monaspace Neon NF"
font-style = "Regular"
font-style-bold = "SemiBold"
font-style-italic = "Italic"
font-style-bold-italic = "SemiBold Italic"
font-synthetic-style = false
font-size = 14
adjust-cell-height = 7%

# Font alternatives ---------------------------------------------------------
