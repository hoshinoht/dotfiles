# ---------------------------------------------------------
# Appearance & Theme
# ---------------------------------------------------------
theme = dusk
background-opacity = 0.85
background-blur-radius = 15
minimum-contrast = 1.1

# Minimal Window Styling (keep traffic light buttons)
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-padding-x = 12
window-padding-y = 12
window-save-state = always

# ---------------------------------------------------------
# Typography
# ---------------------------------------------------------
font-family = "BlexMono Nerd Font Mono"
font-family-bold = "BlexMono Nerd Font Mono"
font-family-italic = "BlexMono Nerd Font Mono"
font-family-bold-italic = "BlexMono Nerd Font Mono"
font-style = "Text"
font-style-bold = "SemiBold"
font-style-italic = "Text Italic"
font-style-bold-italic = "SemiBold Italic"
font-synthetic-style = false
font-size = 13.5
adjust-cell-height = 7%
# ---------------------------------------------------------
# Keybindings
# ---------------------------------------------------------
keybind = cmd+d=new_split:right

# ---------------------------------------------------------
# Cursor & Interaction
# ---------------------------------------------------------
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
copy-on-select = true

# Cursor smear trail (tinted from cursor-color automatically).
# To disable, comment out the next line.
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl

# ---------------------------------------------------------
# Shell & Integration
# ---------------------------------------------------------
shell-integration = zsh
# This helps fix that autocompleter ghosting issue
shell-integration-features = no-cursor,sudo
