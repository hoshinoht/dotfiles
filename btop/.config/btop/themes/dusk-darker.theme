# Dusk Darker theme for btop
# Based on Catppuccin Macchiato with Hoshino-inspired accents

# Main background, empty for terminal default
theme[main_bg]=""

# Main text color
theme[main_fg]="#FFFFFF"

# Title color for boxes
theme[title]="#FFFFFF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8BD3FF"

# Background color of selected item in processes box
theme[selected_bg]="#333B4B"

# Foreground color of selected item in processes box
theme[selected_fg]="#8BD3FF"

# Color of inactive/disabled text
theme[inactive_fg]="#858B9C"

# Color of text appearing on top of graphs
theme[graph_text]="#E6E9F2"

# Background color of the percentage meters
theme[meter_bg]="#333B4B"

# Misc colors for processes box
theme[proc_misc]="#FFB8D1"

# Box outline colors
theme[cpu_box]="#FFB8D1"
theme[mem_box]="#9BE6B5"
theme[net_box]="#8BD3FF"
theme[proc_box]="#B0BCE8"

# Box divider line and small boxes line color
theme[div_line]="#697080"

# Temperature graph (Green -> Yellow -> Red)
theme[temp_start]="#9BE6B5"
theme[temp_mid]="#F4DA86"
theme[temp_end]="#FF8F9A"

# CPU graph colors (Teal -> Sky -> Pink)
theme[cpu_start]="#78E1D0"
theme[cpu_mid]="#8BD3FF"
theme[cpu_end]="#FFB8D1"

# Mem/Disk free meter (Mauve -> Lavender)
theme[free_start]="#C4A2D4"
theme[free_mid]="#B0BCE8"
theme[free_end]="#7BC1F2"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#91ECF1"
theme[cached_mid]="#7BC1F2"
theme[cached_end]="#B0BCE8"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#DDA05C"
theme[available_mid]="#FFA3AC"
theme[available_end]="#FF8F9A"

# Mem/Disk used meter (Green -> Teal -> Sky)
theme[used_start]="#9BE6B5"
theme[used_mid]="#78E1D0"
theme[used_end]="#8BD3FF"

# Download graph colors (Pink -> Mauve)
theme[download_start]="#FFB8D1"
theme[download_mid]="#C4A2D4"
theme[download_end]="#FF8F9A"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#9BE6B5"
theme[upload_mid]="#78E1D0"
theme[upload_end]="#8BD3FF"

# Process box color gradient (Sky -> Pink -> Mauve)
theme[process_start]="#8BD3FF"
theme[process_mid]="#FFB8D1"
theme[process_end]="#C4A2D4"
