#!/bin/bash
# SketchyBar in Dusk Darker, built like the prompt and tmux rails:
#   left:  canvas-to-pink fade into the pink Apple pill (square fade cells,
#          round right cap), then AeroSpace workspaces as one connected base
#          rail with the focused workspace as a surface0 pill;
#   right: the date rail running into the sky clock pill.
# Weight marks the one name that matters: only the focused workspace and the
# clock are SemiBold. Colours are 0xAARRGGBB from the Starship palette
# (scripts/check-theme verifies them).

PLUGIN_DIR="$CONFIG_DIR/plugins"
AEROSPACE=/opt/homebrew/bin/aerospace

TRANSPARENT=0x00000000
FADE1=0xff634751
FADE2=0xffAD7D8E
PINK=0xffFFB8D1
CRUST=0xff171A22
BASE=0xff2A2D35
SURFACE0=0xff383B44
SKY=0xff8BD3FF
SUBTEXT0=0xffC9CAD6

REGULAR="Maple Mono NF:Regular:13.0"
SEMIBOLD="Maple Mono NF:SemiBold:13.0"
PILL=24     # item height inside the 32 pt bar
ROUND=12    # PILL / 2: fully round caps

sketchybar --bar position=top height=32 color=$TRANSPARENT \
                 margin=10 y_offset=4 padding_left=0 padding_right=0 \
                 topmost=off sticky=on

sketchybar --default icon.font="$SEMIBOLD" label.font="$REGULAR" \
                     icon.color=$CRUST label.color=$SUBTEXT0 \
                     padding_left=0 padding_right=0 \
                     icon.padding_left=0 icon.padding_right=0 \
                     label.padding_left=0 label.padding_right=0 \
                     background.height=$PILL

# ── Left: fade → pink Apple pill ──
# The bracket paints the pink pill with round caps; the fade cells' own
# square backgrounds cover its left cap, so only the right cap shows.
for n in 1 2; do
  colour_var="FADE$n"
  sketchybar --add item fade$n left \
             --set fade$n width=9 icon.drawing=off label.drawing=off \
                          background.drawing=on background.corner_radius=0 \
                          background.color=${!colour_var}
done
sketchybar --add item apple left \
           --set apple icon="" icon.color=$CRUST \
                       icon.padding_left=9 icon.padding_right=12 \
                       label.drawing=off \
                       click_script="open -a 'System Settings'"
sketchybar --add bracket apple_pill fade1 fade2 apple \
           --set apple_pill background.color=$PINK background.corner_radius=$ROUND

sketchybar --add item gap_left left --set gap_left width=8 icon.drawing=off label.drawing=off

# ── Left: AeroSpace workspaces as one connected rail ──
sketchybar --add event aerospace_workspace_change
for sid in $("$AEROSPACE" list-workspaces --all); do
  sketchybar --add item space.$sid left \
             --subscribe space.$sid aerospace_workspace_change \
             --set space.$sid icon.drawing=off label="$sid" \
                   label.padding_left=10 label.padding_right=10 \
                   background.color=$SURFACE0 background.corner_radius=$ROUND \
                   background.drawing=off \
                   click_script="$AEROSPACE workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh $sid"
done
sketchybar --add bracket spaces '/space\..*/' \
           --set spaces background.color=$BASE background.corner_radius=$ROUND

# ── Right: date rail running into the clock pill ──
sketchybar --add item clock right \
           --set clock update_freq=30 icon.drawing=off \
                       label.font="$SEMIBOLD" label.color=$CRUST \
                       label.padding_left=10 label.padding_right=12 \
                       background.color=$SKY background.corner_radius=$ROUND \
                       script="$PLUGIN_DIR/clock.sh"
sketchybar --add item date right \
           --set date update_freq=300 icon.drawing=off \
                      label.color=$SUBTEXT0 \
                      label.padding_left=12 label.padding_right=8 \
                      script="$PLUGIN_DIR/date.sh"
sketchybar --add bracket date_rail date clock \
           --set date_rail background.color=$SURFACE0 background.corner_radius=$ROUND

sketchybar --update
sketchybar --trigger aerospace_workspace_change \
           FOCUSED_WORKSPACE="$("$AEROSPACE" list-workspaces --focused)"
