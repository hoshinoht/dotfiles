#!/bin/bash
# JankyBorders in Dusk Darker. Sky marks the focused window, matching tmux's
# active pane border; other windows get surface0 so they recede.
# Colours are 0xAARRGGBB; scripts/check-theme checks them against the palette.

options=(
  style=round
  width=5.0
  hidpi=on
  active_color=0xff8BD3FF
  inactive_color=0xff383B44
)

borders "${options[@]}"
